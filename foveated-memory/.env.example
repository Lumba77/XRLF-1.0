# ═══════════════════════════════════════════════════════
# FOVEATED MEMORY PROXY — Environment Configuration
# ═══════════════════════════════════════════════════════
# This file is auto-loaded by server.js at startup.
# Copy to .env and customize for your setup.

# ── REACTOR MASTER KILL SWITCH (Step 1) ─────────────────────
# XRLF_REPO_ENABLED=false → the repo becomes COLD:
#   - no global caps
#   - no context override
#   - no foveation override
#   - no memory override
#   - no routing override
#   - no interference with your proxy / assistants
# This isolates the repo permanently until you turn it back on.
# This is the correct architecture — current configuration was a developer mistake.
XRLF_REPO_ENABLED=false

# ── Individual Override Isolators (Step 2A) ─────────────────
# Each can be toggled independently on top of the master switch.
# When XRLF_REPO_ENABLED=false, these all default to false too.
# When XRLF_REPO_ENABLED=true, these default to true unless overridden.
# XRLF_CONTEXT_OVERRIDE=false      # Disable repo context override
# XRLF_CAPABILITY_OVERRIDE=false   # Disable repo capabilities override
# XRLF_FOVEATION_OVERRIDE=false     # Disable repo foveation override

# ── Core ─────────────────────────────────────────────────────
# LUMAX_COGNITIVE_MODE=local        # local | cloud
# LUMAX_PROXY_MODEL=                # Override upstream model name
# LUMAX_MODEL_LOCAL_ID=             # Local LM Studio model ID
# LUMAX_MODEL_CLOUD_ID=             # Cloud model ID (Ollama Cloud)

# ── Code Preservation ────────────────────────────────────────
# When enabled (default), critical code structures are extracted
# BEFORE the stripping/compression pipeline and restored AFTER.
# This prevents code fences, thinking blocks, JSON schemas, and
# tool definitions from being destroyed by aggressive compression.
# Conditioned by XRLF_CAPABILITY_OVERRIDE.
LUMAX_PRESERVE_CODE=true

# ── Context Healer ───────────────────────────────────────────
# LUMAX_CTX_MAX_CHARS=50000         # Max context budget in chars
# LUMAX_CTX_MIN_CHARS=4000          # Min context budget
# LUMAX_CTX_BACKOFF=0.5             # Shrink factor on failure
# LUMAX_CTX_RECOVERY=2000           # Recovery step on success
# LUMAX_CTX_MAX_RETRIES=3           # Max retry attempts
# LUMAX_CTX_KEEP_LAST=6             # Messages to preserve at end

# ── Compression ──────────────────────────────────────────────
# LUMAX_PROXY_AUTO_CHECKPOINT=true  # Enable XRL checkpointing
# FOVEA_COMPRESS_EVERY=6            # Turns between compressions
# FOVEA_WINDOW=4                    # Recent turns kept verbatim
# FOVEA_SUMMARY_TOKENS=300          # Max tokens per checkpoint

# ── Smart Router ─────────────────────────────────────────────
# LUMAX_SMART_PROXY=true            # Enable middleman routing
# LUMAX_MIDDLEMAN_MODEL=            # Model for compression/routing
# LUMAX_MIDDLEMAN_GPU_OFFLOAD=0.2   # GPU offload for middleman

# ── Foveation ────────────────────────────────────────────────
# LUMAX_PROXY_AGGRESSION=0          # 0=Auto, 1-6=Manual override
# LUMAX_SPOOF_CONTEXT_WINDOW=128000 # Report larger window to clients
# LUMAX_SAFE_MODE=false             # Disable context spoofing